<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- Pure logic, no Maho install required. -->
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
        <!-- Needs a real Maho install via MAHO_ROOT (see tests/bootstrap.php). -->
        <testsuite name="Integration">
            <directory suffix="Test.php">tests/integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app/code/community/MageAustralia/B2bAccess/Helper</directory>
            <directory>app/code/community/MageAustralia/B2bAccess/Model</directory>
        </include>
    </source>
</phpunit>
