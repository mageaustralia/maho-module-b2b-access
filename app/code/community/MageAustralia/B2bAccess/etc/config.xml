<config>
    <modules>
        <MageAustralia_B2bAccess>
            <version>1.0.0</version>
        </MageAustralia_B2bAccess>
    </modules>

    <global>
        <helpers>
            <b2baccess>
                <class>MageAustralia_B2bAccess_Helper</class>
            </b2baccess>
        </helpers>
        <models>
            <b2baccess>
                <class>MageAustralia_B2bAccess_Model</class>
            </b2baccess>
        </models>
        <!--
             Observers are registered via #[Maho\Config\Observer] PHP attributes
             on Model/Observer.php (compiled at composer dump-autoload into
             vendor/composer/maho_attributes.php). No <events> XML here.
        -->
    </global>

    <frontend>
        <translate>
            <modules>
                <MageAustralia_B2bAccess>
                    <files>
                        <default>MageAustralia_B2bAccess.csv</default>
                    </files>
                </MageAustralia_B2bAccess>
            </modules>
        </translate>
    </frontend>

    <adminhtml>
        <translate>
            <modules>
                <MageAustralia_B2bAccess>
                    <files>
                        <default>MageAustralia_B2bAccess.csv</default>
                    </files>
                </MageAustralia_B2bAccess>
            </modules>
        </translate>
    </adminhtml>

    <default>
        <b2baccess>
            <general>
                <enabled>0</enabled>
                <mode>basic</mode>
            </general>
            <login>
                <required>0</required>
                <redirect_cms></redirect_cms>
                <message>Please log in to view this store.</message>
            </login>
            <price>
                <hide>0</hide>
                <hide_listing>0</hide_listing>
                <message>Log in to see pricing.</message>
                <block_purchase>1</block_purchase>
            </price>
            <matrix>
                <by_customer>0</by_customer>
                <customer_groups></customer_groups>
                <by_category>0</by_category>
                <categories></categories>
            </matrix>
        </b2baccess>
    </default>
</config>
